# ── Deployment ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# "cloud" = many restaurants on one server.  "local" = old single-restaurant PC mode
DEPLOYMENT=cloud
# Where accounts.db and every restaurant's database live (back this folder up!)
DATA_DIR=/var/lib/restaurant-pos

# ── HTTPS / proxy ───────────────────────────────────────────────────────
# Cookies are sent only over HTTPS when true. Keep true in production.
COOKIE_SECURE=true
# Number of reverse proxies in front of Node (nginx/Caddy = 1). Needed for real client IPs.
TRUST_PROXY=1
# Public address of the site (used for pairing links)
PUBLIC_URL=https://pos.example.com
# Only needed if the frontend is served from a DIFFERENT origin. Comma separated.
CORS_ORIGINS=

# ── Accounts ────────────────────────────────────────────────────────────
ALLOW_REGISTRATION=true
# Comma list. Today: password.  Later: password,otp
AUTH_METHODS=password
DEFAULT_COUNTRY_CODE=91
# How many restaurant databases may be open in memory at once
MAX_OPEN_TENANTS=100

# ── Existing optional settings ──────────────────────────────────────────
BUG_REPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Root console / plans ────────────────────────────────────────────────
# false = trial dates are only informational. Set true once billing exists: restaurants on the
# 'trial' plan are blocked after trial_ends_at.
ENFORCE_TRIAL=false
# (BUG_REPORT_EMAIL / SMTP_* are no longer used: tickets go to the root console.)